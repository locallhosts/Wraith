# Copy to .env and fill in real values. Never commit the filled-in file.

# --- Core ---
WRAITH_PORT=8080
WRAITH_RULES_DIR=./rules
WRAITH_ES_ADDR=http://localhost:9200
WRAITH_NEO4J_ADDR=bolt://localhost:7687

# --- GitHub webhook (required in production; unset = webhook rejects everything) ---
WRAITH_WEBHOOK_SECRET=

# --- Persistence: unset = ephemeral in-memory store (dev only, no durability) ---
WRAITH_DATABASE_URL=postgres://wraith:wraith@localhost:5432/wraith?sslmode=disable

# --- Provenance / supply-chain attestation (see docs/ENTERPRISE.md) ---
# Generate with: go run ./backend-go keygen
# Public key goes here on servers that verify/deploy; private key is a CI-only secret.
WRAITH_SIGNING_PUBLIC_KEY=
WRAITH_SIGNING_PRIVATE_KEY=

# --- Notifications (optional) ---
WRAITH_SLACK_WEBHOOK_URL=

# --- Rate limiting ---
WRAITH_RATE_LIMIT_RPM=120

# --- SOAR playbook generation ---
ANTHROPIC_API_KEY=

# --- GitHub PR automation for SOAR playbooks ---
GITHUB_TOKEN=
GITHUB_REPO=yourname/wraith
GITHUB_BASE_BRANCH=main

# --- Frontend ---
NEXT_PUBLIC_API_BASE=http://localhost:8080
